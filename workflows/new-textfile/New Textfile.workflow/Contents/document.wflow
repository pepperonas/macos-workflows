				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>f="$1"

if [ -d "$f" ]; then
    dir="$f"
else
    dir="$(dirname "$f")"
fi

name="Untitled.txt"
target="${dir}/${name}"

# If file exists, append number
i=1
while [ -e "$target" ]; do
    target="${dir}/Untitled ${i}.txt"
    i=$((i + 1))
done

touch "$target"
open "$target"</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
